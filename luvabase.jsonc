{
  "$schema": "node_modules/@luvabase/sdk/dist/manifest-schema.json",
  "name": "luvachat",
  "identifier": "io-flown-luvachat",
  "icon": "icon.png",
  "description": "Messaging app similar to Slack",
  "surfaces": [
    {
      "type": "web",
    },
    {
      "type": "ios",
      "identifier": "io.flown.luvachat",
      "redirectUrls": ["io.flown.luvachat://oauth-callback"],
      "downloadLink": "https://apps.apple.com/us/app/peach-classes-workshops/id1518270776",
    },
  ],
  "services": [
    {
      "type": "openrouter",
      "name": "OPENROUTER",
    },
    {
      "type": "durable-object",
      "name": "SyncObject",
    },
    {
      "type": "r2",
      "name": "MAIN_BUCKET",
    },
  ],
}
