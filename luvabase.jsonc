{
  "$schema": "node_modules/luvabase/manifest-schema.json",
  "name": "Luvachat",
  "subtitle": "Team messaging & chat",
  "identifier": "luvachat",
  "icon": "icon.png",
  "description": "Team messaging with channels and conversations, threaded replies, search, and an activity feed. Real-time sync, rich text and attachments, and workspace members—Slack-style collaboration.",
  "surfaces": [
    {
      "type": "web",
    },
    {
      "type": "ios",
      "identifier": "io.flown.luvachat",
      "redirectUrls": ["io.flown.luvachat://oauth-callback"],
      "downloadLink": "https://apps.apple.com/us/app/peach-classes-workshops/id1518270776",
    },
  ],
  "worker": {
    "main": "src/server.tsx",
    "compatibilityDate": "2026-03-17",
    "compatibilityFlags": ["nodejs_compat"],
    "migrations": [
      {
        "tag": "v1",
        "newSqliteClasses": ["SyncObject"],
      },
    ],
  },
  "resources": [
    {
      "type": "openrouter",
      "name": "OPENROUTER",
    },
    {
      "type": "durable-object",
      "name": "SyncObject",
      "className": "SyncObject",
    },
    {
      "type": "turso",
      "name": "MAINDB",
    },
    {
      "type": "r2",
      "name": "MAIN_BUCKET",
    },
  ],
}
