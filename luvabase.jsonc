{
  "$schema": "node_modules/luvabase/manifest-schema.json",
  "name": "Luvachat",
  "subtitle": "Team messaging & chat",
  "identifier": "luvachat",
  "icon": "icon.png",
  "description": "Team messaging with channels and conversations, threaded replies, search, and an activity feed. Real-time sync, rich text and attachments, and workspace members—Slack-style collaboration.",
  "surfaces": [
    {
      "type": "web",
    },
    {
      "type": "ios",
      "identifier": "io.flown.luvachat",
      "redirectUrls": [
        "io.flown.luvachat://oauth-callback"
      ],
      "downloadLink": "https://apps.apple.com/us/app/peach-classes-workshops/id1518270776",
    },
  ],
}