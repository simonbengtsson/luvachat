{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luvachat3",
  "workers_dev": true,
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.tsx",
  "secrets": {
    "required": ["OPENROUTER_API_KEY"],
  },
  "r2_buckets": [
    {
      "binding": "MAIN_BUCKET",
      "bucket_name": "luvachatlocal",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SyncObject",
        "class_name": "SyncObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
