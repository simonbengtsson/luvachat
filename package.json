{
  "name": "luvachat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "submit": "bun run bundle && bun run copy:bundle && open https://luvabase.com/dash/submit-app",
    "copy:bundle": "osascript -e \"set the clipboard to (POSIX file \\\"$(realpath app.luva)\\\")\"",
    "bundle": "luvabase bundle",
    "d:gen": "drizzle-kit generate",
    "dev": "vite dev --port 3000 --host",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "test": "vitest run",
    "deploy:staging": "bun run build && wrangler deploy",
    "check": "bunx tsc --noEmit",
    "deploy": "luvabase deploy",
    "types": "wrangler types"
  },
  "dependencies": {
